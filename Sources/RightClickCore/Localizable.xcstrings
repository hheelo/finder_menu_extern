    "onboarding.extension_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable the Finder Extension" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "启用 Finder 扩展" } } } },
    "onboarding.extension_waiting" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Waiting for the extension to be enabled…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在等待扩展启用…" } } } },
    "onboarding.permissions_detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Notification and terminal automation permissions are requested only when a related action first needs them, never early in this guide." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "通知与终端自动化权限只会在相关操作首次需要时询问，不会在向导中提前请求。" } } } },
