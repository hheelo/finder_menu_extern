    "onboarding.progress" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Step %1$lld of %2$lld" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "第 %1$lld 步，共 %2$lld 步" } } } },
    "onboarding.settings_hint" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Settings also lets you customize the menu, monitored folders, AI CLIs, and file templates." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设置中还可以调整菜单、监控目录、自定义 CLI 和文件模板。" } } } },
    "onboarding.terminal_detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open in Terminal and AI CLI actions use this terminal. An unavailable choice safely falls back to Terminal." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "“在终端中打开”和 AI CLI 动作会使用这个终端。未安装的终端会安全回退到 Terminal。" } } } },
    "onboarding.terminal_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose a Default Terminal" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选择默认终端" } } } },
    "onboarding.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Welcome to RightClick" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "欢迎使用 RightClick" } } } },
    "onboarding.try_detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Right-click any file or folder in Finder to find copy, editor, terminal, and new-file actions." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在 Finder 中右键任意文件或文件夹，就能看到复制、编辑器、终端和新建文件等操作。" } } } },
    "onboarding.try_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Try It in Finder" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "现在去 Finder 试一下" } } } },
    "settings.argument_number" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Argument %lld" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "参数 %lld" } } } },
    "settings.cli_executable" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Command Name or Absolute Path" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "命令名或绝对路径" } } } },
    "settings.cli_security_help" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enter a command available in PATH or an absolute executable path. Deep links contain only the profile ID; the command and arguments stay in a local 0600 file. Enter each argument separately; full shell command lines are not parsed." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可填写 PATH 中的命令名或可执行文件的绝对路径。深链只携带配置 ID；命令与参数保存在权限为 0600 的本机配置文件中。每个参数单独填写，不解析整行 shell 命令。" } } } },
    "settings.cli_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Custom AI CLIs" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自定义 AI CLI" } } } },
    "settings.collapse_menu" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Place all items in a RightClick submenu" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "收进一个 RightClick 子菜单" } } } },
    "settings.copy_separator" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Multi-selection separator" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "多选复制时分隔符" } } } },
    "settings.diagnostics" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Environment Diagnostics" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "环境诊断" } } } },
    "settings.drag_to_reorder" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Drag menu items to reorder them." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "拖动菜单项可调整顺序。" } } } },
    "settings.export_local_log" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Export Local Action Log" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "导出本地动作日志" } } } },
    "settings.local_log_help" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Merges the latest 200 action outcomes and unexpected-termination markers when exporting. File paths, filenames, command arguments, and deep-link contents are never recorded." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "导出时合并最近 200 条动作结果和异常终止标记；不记录文件路径、文件名、命令参数或深链内容。" } } } },
    "settings.display_name" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Display Name" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "显示名称" } } } },
    "settings.finder_menu" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Finder Menu" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Finder 菜单" } } } },
    "settings.menu_immediate_help" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Changes apply the next time you open the Finder context menu; Finder does not need to restart." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "修改后下一次打开 Finder 右键菜单立即生效，无需重启 Finder。" } } } },
    "settings.monitor_all_directories" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "All folders (/)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "所有目录（/）" } } } },
    "settings.monitored_directories" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Finder Monitored Folders" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Finder 监控目录" } } } },
    "settings.monitored_directories_help" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "RightClick appears only in these folders and their subfolders. Restart Finder after changes. Removing the last item restores monitoring of all folders. Unavailable external-drive paths are skipped when the extension starts." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "RightClick 只在这些目录及其子目录中显示。修改后需要重启 Finder；移除最后一项会恢复监控所有目录。不可用的外置磁盘路径会在扩展启动时跳过。" } } } },
    "settings.run_cli_behavior" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "When running an AI CLI" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "运行 AI CLI 时" } } } },
    "settings.restart_onboarding_help" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Shows the three-step first-time setup again without clearing your menu or terminal configuration." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重新显示三步首次设置；现有菜单和终端配置不会被清除。" } } } },
    "settings.security_help" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The first terminal command may prompt for permission to control Terminal or iTerm2. Finder actions are handled in the background without showing the RightClick window. New Terminal tabs also require Accessibility permission." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "首次运行终端命令时，macOS 可能询问是否允许 RightClick 控制 Terminal 或 iTerm2。Finder 动作会在后台交给 RightClick 处理，不会显示宿主窗口。Terminal 的新标签页还需要允许 RightClick 使用辅助功能。" } } } },
    "settings.show_in_finder" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Show in Finder Menu" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "显示在 Finder 菜单" } } } },
    "settings.synced_templates" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld synced" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已同步 %lld 个" } } } },
    "settings.tab.diagnostics" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Diagnostics" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "诊断" } } } },
    "settings.tab.menu" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Menu" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "菜单" } } } },
    "settings.tab.templates" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Templates" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "模板" } } } },
    "settings.tab.terminal" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Terminal" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "终端" } } } },
    "settings.template_encoding" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ Encoding" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ 编码" } } } },
    "settings.templates" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Custom File Templates" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自定义文件模板" } } } },
    "settings.templates_help" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Place files in ~/Library/Application Support/RightClick/Templates/. After refreshing, each original filename appears in Finder's New File menu." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "把文件放入 ~/Library/Application Support/RightClick/Templates/，刷新后会按原文件名出现在 Finder 的“新建文件”菜单中。" } } } },
    "settings.terminal" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Terminal" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "终端" } } } },
    "settings.terminal_help" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open in Terminal and Run AI CLI both use the default terminal. Automatic prefers iTerm2; unavailable terminals fall back to Terminal. Warp and Ghostty currently open folders only." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "“在终端中打开”与“运行 AI CLI”都使用默认终端。选自动时优先 iTerm2；未安装的终端回退到 Terminal。Warp 与 Ghostty 当前只支持打开目录。" } } } },
    "settings.terminal_picker" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Default Terminal" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "默认终端" } } } },
    "status.copied_diagnostics" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Diagnostics copied" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "诊断信息已复制" } } } },
    "status.created_item" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Item created" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已新建项目" } } } },
    "status.creating_item" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Creating item…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在新建项目…" } } } },
    "status.exported_local_log" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Local action log exported" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "本地动作日志已导出" } } } },
    "status.menu_saved" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Finder menu settings saved" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Finder 菜单设置已保存" } } } },
    "status.opened_with" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Opened with %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已用 %@ 打开" } } } },
    "status.opening_with" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Opening with %@…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在用 %@ 打开…" } } } },
    "status.reloaded_finder" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Finder reloaded for this version" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已为当前版本重新加载 Finder" } } } },
    "status.restarting_finder" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Restarting Finder" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在重启 Finder" } } } },
    "status.restarted_finder" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Finder restarted" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Finder 已重新启动" } } } },
    "status.started" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Started %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已启动 %@" } } } },
    "status.starting" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Starting %@…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在启动 %@…" } } } },
    "status.synced_templates" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Synced %lld custom templates" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已同步 %lld 个自定义模板" } } } },
    "status.waiting" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Waiting for a Finder action" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "等待 Finder 操作" } } } },
    "error.finder_reopen" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not reopen Finder: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法重新打开 Finder：%@" } } } },
    "error.finder_restart" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not restart Finder. Log out and try again." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法重启 Finder，请退出登录后重试。" } } } },
    "error.finder_timeout" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Finder did not quit. Log out and try again." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Finder 未能退出，请退出登录后重试。" } } } },
    "error.osascript_status" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "osascript exited with status %lld" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "osascript 返回状态 %lld" } } } },
    "error.terminal_accessibility" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not create a Terminal tab. Allow RightClick to use Accessibility in Privacy & Security settings." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法创建 Terminal 标签页；请在系统设置的隐私与安全性中允许 RightClick 使用辅助功能。" } } } },
    "error.unsupported_applescript" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This terminal does not support the AppleScript launch strategy." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "该终端不支持 AppleScript 启动策略。" } } } },
    "button.export_settings" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Export Settings…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "导出设置…" } } } },
    "button.import_settings" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Import Settings…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "导入设置…" } } } },
    "button.reset_settings" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reset Settings" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重置设置" } } } },
    "error.export_settings" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not export RightClick settings: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法导出 RightClick 设置：%@" } } } },
    "error.import_settings" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not import RightClick settings: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法导入 RightClick 设置：%@" } } } },
    "error.menu_configuration_backup" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The configuration is invalid and a recovery backup could not be created: %@. The original file will not be overwritten." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "配置异常且无法创建恢复备份：%@。原文件不会被覆盖。" } } } },
    "error.menu_configuration_corrupted" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The Finder menu configuration is corrupted." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Finder 菜单配置已损坏。" } } } },
    "error.menu_configuration_invalid" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The Finder menu configuration is invalid." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Finder 菜单配置无效。" } } } },
    "error.menu_configuration_newer" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The Finder menu configuration was created by a newer version (v%lld)." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Finder 菜单配置来自较新的版本（v%lld）。" } } } },
    "error.menu_configuration_recovery_required" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Import valid settings or explicitly reset them in Settings before making changes." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请导入有效设置或在设置中明确重置后再修改。" } } } },
    "error.menu_configuration_recovery_with_backup" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ A backup was saved to %@; the original will not be overwritten until valid settings are imported or you explicitly reset it." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ 已备份到 %@；导入有效设置或明确重置前不会覆盖原文件。" } } } },
    "error.menu_configuration_unreadable" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The Finder menu configuration cannot be read." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Finder 菜单配置无法读取。" } } } },
    "error.reset_settings" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not reset Finder menu settings: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法重置 Finder 菜单设置：%@" } } } },
    "error.settings_document_invalid" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The settings file is invalid or corrupted." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设置文件内容无效或已损坏。" } } } },
    "error.settings_document_too_large" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The settings file exceeds the 2 MB limit." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设置文件超过 2 MB 上限。" } } } },
    "error.settings_document_unsupported" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This settings file format version is not supported." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设置文件格式版本不受支持。" } } } },
    "settings.configuration_recovery_required" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The menu configuration could not be loaded safely. Menu editing is paused until you import valid settings or explicitly reset it." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "菜单配置无法安全加载。导入有效设置或明确重置前，菜单编辑已暂停。" } } } },
    "settings.export_settings" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Export RightClick Settings" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "导出 RightClick 设置" } } } },
    "settings.reset_configuration_confirmation" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reset Finder menu settings? The original configuration will be backed up first." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重置 Finder 菜单设置？原配置会先保留备份。" } } } },
    "settings.settings_transfer_help" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Import and export includes menu order, custom CLIs, and built-in template options. This Mac's terminal choice and custom template files stay unchanged." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "导入导出包含菜单顺序、自定义 CLI 和内置模板选项；本机终端选择与自定义模板文件保持不变。" } } } },
    "status.exported_settings" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "RightClick settings exported" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "RightClick 设置已导出" } } } },
    "status.imported_settings" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "RightClick settings imported" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "RightClick 设置已导入" } } } },
    "status.reset_settings" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Finder menu settings reset" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Finder 菜单设置已重置" } } } },
    "settings.default_cli_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Custom CLI" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自定义 CLI" } } } },
    "status.default_app" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "the default app" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "默认应用" } } } }
  },
  "version" : "1.0"
}
