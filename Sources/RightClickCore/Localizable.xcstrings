    "onboarding.extension_detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "RightClick needs its Finder extension to add actions to context menus. When System Settings opens, enable RightClick Finder Extension." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "RightClick 需要 Finder 扩展才能把操作加入右键菜单。系统设置打开后，请启用 RightClick Finder Extension。" } } } },
